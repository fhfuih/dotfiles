# This file contains environments for general, both non-/interactive shells
# shellcheck disable=SC2148

# >>> XDG conventions
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
# <<<

# >>> PATHs
# home/bin: for miktex
# home/.local/bin: my own binaries are here
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# homebrew. Do this before checking/using any command
if command -v brew >/dev/null || [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    if [ -n "$IS_CHINA" ]; then
        export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
        export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git"
        export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
    fi
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

# Android SDK
export PATH="$HOME/Library/Android/sdk/platform-tools:$PATH"

# google cloud sdk
export CLOUDSDK_HOME="$HOME/.local/google-cloud-sdk"
if [ -f "$CLOUDSDK_HOME/path.zsh.inc" ]; then
    . "$CLOUDSDK_HOME/path.zsh.inc"
fi

# VS Code
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# dart/flutter pub
if command -v dart >/dev/null 2>&1; then
  export PATH="$PATH:$HOME/.pub-cache/bin"
fi

# rustup
if [ -d "/opt/homebrew/opt/rustup/bin" ]; then
  export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
fi

# openjdk
if [ -d "/opt/homebrew/opt/openjdk/bin" ]; then
  export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
fi

# qt
{{ if eq .chezmoi.os "darwin" }}
qt_path=$(find ~/Qt -path '*/macos/bin' -type d -depth 3 | head -n 1) && {
  export PATH="${qt_path}:$PATH"
}
{{ end }}

# neovim
if [ -d "$HOME/.local/opt/neovim" ]; then
  export PATH="$HOME/.local/opt/neovim/bin:$PATH"
fi

# Default softwares
if command -v nvim >/dev/null 2>&1; then
  export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
  export VISUAL=vim
fi
  

# Program and compiler configs
export CPPFLAGS="-I/opt/homebrew/opt/openjdk/include"
export CHKTEXRC="$HOME/.config/chktex"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# Local config overwrite
source "$HOME/.config/sh/local.sh"
