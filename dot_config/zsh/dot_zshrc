# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.config/zsh/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# zmodload zsh/zprof
export HAS_ZSHRC=true
alias reload='source "${ZDOTDIR:-$HOME}/.zshrc"'

# alias & functions
if [[ -f  "$HOME/.config/sh/alias.sh" ]]; then
    source "$HOME/.config/sh/alias.sh"
fi

# Plugin config
### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ -e "${ZINIT_HOME}/zinit.zsh" ]]; then
    source "${ZINIT_HOME}/zinit.zsh"
    zinit light zsh-users/zsh-autosuggestions
    zinit light zdharma-continuum/fast-syntax-highlighting
    zinit light zdharma-continuum/history-search-multi-word
    zinit ice depth"1"
    zinit light romkatv/powerlevel10k
    # zinit ice depth=1
fi
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit
### End of Zinit's installer chunk

# Interactive shell-only tool activation
if command -v mise >/dev/null; then
    eval "$(mise activate zsh)"
fi

# Completion configs
if command -v brew >/dev/null; then
    fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi
autoload -U compinit; compinit
# gcloud: sourced after compinit so its internal guard (it runs compinit if
# compdef is missing) doesn't double-load the completion system
if [[ -f "$HOME/.local/google-cloud-sdk/completion.zsh.inc" ]]; then . "$HOME/.local/google-cloud-sdk/completion.zsh.inc"; fi
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*:*:*:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:warnings' format ' %F{red}-- no matches found --%f'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

if command -v pip >/dev/null; then
  eval "$(pip completion --zsh)"
fi

if command -v uv >/dev/null; then
  eval "$(uv generate-shell-completion zsh)"
fi

if command -v fnm >/dev/null; then
  eval "$(fnm completions --shell zsh)"
fi

if command -v pnpm >/dev/null; then
  eval "$(pnpm completion zsh)"
fi

if command -v gh >/dev/null; then
  eval "$(gh completion -s zsh)"
fi

if command -v supabase >/dev/null; then
  supabase() {
    unfunction "$0"
    source <(supabase completion zsh)
    $0 "$@"
  }
fi

# my pinyin completion
# complete -o nospace -C /Users/zeyu/go/bin/gocomplete go

# Non-auto-complete software setup

if [ -f $HOME/venv/bin/activate ]; then
  source $HOME/venv/bin/activate
elif [ -f $HOME/.venv/bin/activate ]; then
  source $HOME/.venv/bin/activate
fi

# Zoxide must be added after compinit is called and to the end of the configuration
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
[[ ! -f ~/.config/zsh/.p10k.zsh ]] || source ~/.config/zsh/.p10k.zsh

